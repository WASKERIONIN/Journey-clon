; Engine configuration file.
; Песчаное море: рыбалка на берегу, где море сделано из песка.
; Рендерер жёстко зафиксирован: Forward+ (Vulkan) для объёмного тумана,
; glow и SDF-существ. Ввод создаётся кодом (Game._ensure_input), поэтому
; секции [input] нет — действия живут в одном месте.

config_version=5

[application]

config/name="To The Light"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray()

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
; MSAA 2x, а не 4x: связка «PSSM-тени + экранные эффекты (SSAO/SSIL) +
; MSAA 4x/8x» даёт в Forward+ чёрные прямоугольники вокруг геометрии
; (godotengine/godot#103669, #81060) — именно их видно на песке ночью.
; 2x убирает лесенку на дюнах и не попадает в известную комбинацию.
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.35, 0.27, 0.38, 1)
